# Neon application connection (pooled; use for normal runtime queries)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require

# Neon direct connection (use for Drizzle migrations and administrative tasks)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require

# Pusher Channels server-only credentials
PUSHER_APP_ID=your-app-id
PUSHER_SECRET=your-app-secret

# Pusher public client configuration (also reused by the server publisher)
NEXT_PUBLIC_PUSHER_APP_KEY=your-app-key
NEXT_PUBLIC_PUSHER_CLUSTER=your-cluster

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
