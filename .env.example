# Neon application connection (pooled; use for normal runtime queries)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require

# Neon direct connection (use for Drizzle migrations and administrative tasks)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require

# Safety label checked by reset/seed tooling. The URL—not this label—selects
# the real Neon branch.
NEON_BRANCH=development

# Pusher Channels server-only credentials
PUSHER_APP_ID=your-app-id
PUSHER_SECRET=your-app-secret

# Pusher public client configuration (also reused by the server publisher)
NEXT_PUBLIC_PUSHER_APP_KEY=your-app-key
NEXT_PUBLIC_PUSHER_CLUSTER=your-cluster

# Protects the bounded outbox retry endpoint used by a scheduler/cron.
OUTBOX_DRAIN_SECRET=replace-with-a-long-random-secret

# Protects Vercel's daily rolling demo refresh. Keep refresh disabled outside
# the public production demo; Vercel sends CRON_SECRET as a Bearer token.
CRON_SECRET=replace-with-a-different-long-random-secret
DEMO_REFRESH_ENABLED=false

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
